# Resonance for zsh and Oh My Zsh: completions, short commands, and what's
# playing for your prompt. https://useresonance.app
#
# Oh My Zsh:  link this folder to $ZSH_CUSTOM/plugins/resonance, then add
#             `resonance` to plugins=(...) in ~/.zshrc.
# Plain zsh:  source this file from ~/.zshrc, after compinit.

(( $+commands[resonance] )) || return 0

# Short commands.
alias rn='resonance next'
alias rp='resonance toggle'
alias rs='resonance surprise'
alias rl='resonance like --play'
alias rf='resonance fav'
alias rq='resonance now'

# Run something slow, then get a surprise when it ends, however it ended:
#   rdone make release
rdone() {
  "$@"
  local result=$?
  resonance surprise
  return $result
}

# What's playing, for a prompt or a tmux status line: "♪ Commando · Rob Hubbard",
# or nothing when nothing's playing. The app keeps it in a file, so this is only
# a file read and never slows a prompt down.
#   RPROMPT='$(resonance_prompt_info)'      (needs `setopt prompt_subst`)
resonance_prompt_info() {
  # The sandboxed app's folder; builds before alpha.6 used the plain one.
  local support="Library/Application Support/Resonance/now-playing.txt"
  local file="$HOME/Library/Containers/app.useresonance.resonance/Data/$support"
  [[ -r $file ]] || file="$HOME/$support"
  [[ -r $file ]] || return 0
  print -r -- "${ZSH_THEME_RESONANCE_PREFIX-♪ }$(<"$file")${ZSH_THEME_RESONANCE_SUFFIX-}"
}

# Completions, generated by the tool and remade when it changes.
() {
  local dir="${ZSH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/resonance}/completions"
  local file="$dir/_resonance"
  mkdir -p "$dir" 2>/dev/null || return 0
  if [[ ! -s $file || $commands[resonance] -nt $file ]]; then
    resonance completions zsh >| "$file" 2>/dev/null
  fi
  fpath=("$dir" $fpath)
  autoload -Uz _resonance
}

# Your playlists' names after `resonance playlist <command>`; only if the app
# is running, so a Tab never starts it.
_resonance_with_playlists() {
  local socket="$HOME/Library/Application Support/Resonance/control.sock"
  if [[ $words[2] == playlist && $CURRENT -eq 4 && $words[3] != (list|new) && -S $socket ]]; then
    local -a names
    names=("${(@f)$(RESONANCE_NO_LAUNCH=1 resonance playlist list 2>/dev/null)}")
    (( $#names )) && { compadd -a names; return }
  fi
  _resonance "$@"
}
(( $+functions[compdef] )) && compdef _resonance_with_playlists resonance
