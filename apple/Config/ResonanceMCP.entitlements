<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- resonance-mcp, the MCP server an assistant runs: the App Sandbox and the
     app group whose container holds the app's socket, nothing else.
     scripts/build-cli.sh puts the team in for TEAM. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>TEAM.resonance</string>
	</array>
</dict>
</plist>
