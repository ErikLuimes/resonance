<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged with the Info.plist Xcode generates (GENERATE_INFOPLIST_FILE):
  only the keys that have no INFOPLIST_KEY_* build setting live here.
-->
<plist version="1.0">
<dict>
	<!-- "alpha.1", "beta.2"; empty for a final release. About shows it
	     after the version: 0.1.0-alpha.1. -->
	<key>ResonanceReleaseStage</key>
	<string>$(RELEASE_STAGE)</string>
	<!-- Sparkle updates. Both come from build settings and are empty in
	     Debug builds, which don't update themselves: the feed on the
	     website, and the public half of the EdDSA key release.sh signs
	     updates with (scripts/release.sh checks they match). -->
	<key>SUFeedURL</key>
	<string>$(SPARKLE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_ED_KEY)</string>
	<!-- Check daily without asking first; nothing about the Mac is sent. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<!-- Shared tune links: the share server's address (no trailing slash),
	     from the SHARE_BASE_URL build setting: https://useresonance.app in
	     Release builds, a share-server running on this Mac in Debug ones.
	     Empty: no Share buttons. -->
	<key>ResonanceShareBaseURL</key>
	<string>$(SHARE_BASE_URL)</string>
	<!-- resonance://tune/<md5>?s=2&amp;v=85&amp;p=/MUSICIANS/… opens a shared
	     tune; the share server's page links there. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>nl.luimes.resonance.tune</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>resonance</string>
			</array>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>SID Tune</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.hvsc.sid</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Playlist</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.m3u-playlist</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.hvsc.sid</string>
			<key>UTTypeDescription</key>
			<string>Commodore 64 SID tune</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.audio</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>sid</string>
					<string>psid</string>
					<string>rsid</string>
					<string>mus</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>nl.luimes.resonance.playlist-row</string>
			<key>UTTypeDescription</key>
			<string>Resonance playlist row</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
