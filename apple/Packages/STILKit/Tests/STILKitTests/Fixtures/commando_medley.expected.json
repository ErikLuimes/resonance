          "blocks": [
            {
              "kind": "quote",
              "by": "Rob Hubbard",
              "role": "composer",
              "paragraphs": [
                [
                  {
                    "t": "There is an interesting story behind Commando. I went down to their office and started working on it late at night, and worked on it through the night. I took one listen to the original arcade version and started working on the C64 version. I think they wanted some resemblance to the arcade version, but I just did what I wanted to do. By the time everyone arrived at 8.00am in the morning, I had loaded the main tune on every C64 in the building! I got my cheque and was on a train home by 10.00 am…"
                  }
                ]
              ]
            }
          ],
          "memoriam": false,
          "teaser": "There is an interesting story behind Commando.",
          "links": []
        }
      ]
